generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Departamento {
  id           Int        @id
  nombre       String
  codigoDane   String     @unique @map("codigo_dane")
  municipios   Municipio[]

  @@map("departamento")
}

model Municipio {
  id                 Int                  @id @default(autoincrement())
  departamentoId     Int                  @map("departamento_id")
  codigoDane         String               @unique @map("codigo_dane")
  nombre             String
  latitud            Decimal?             @db.Decimal(10, 8)
  longitud           Decimal?             @db.Decimal(11, 8)
  ubicacion          Unsupported("geometry(Point, 4326)")?
  estado             Boolean              @default(true)
  fechaCreacion      DateTime             @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime             @default(now()) @updatedAt @map("fecha_actualizacion")
  departamento       Departamento         @relation(fields: [departamentoId], references: [id])
  usuarios           Usuario[]
  afectaciones       Afectacion[]
  centroAcopio       CentroAcopio[]
  beneficiarios      Beneficiario[]
  denuncias          Denuncia[]
  albergues          Albergue[]

  @@map("municipio")
}

model Organizacion {
  id               BigInt          @id @default(autoincrement())
  nombre           String          @unique
  tipo             String
  identificacion   String          @unique
  responsable      String
  telefono         String?
  correo           String?
  estado           String          @default("ACTIVA")
  fechaCreacion    DateTime        @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime       @default(now()) @updatedAt @map("fecha_actualizacion")
  usuarios         Usuario[]
  centrosAcopio    CentroAcopio[]
  gastos           Gasto[]
  donaciones       Donacion[]

  @@map("organizacion")
}

model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  descripcion String?
  activo      Boolean      @default(true)
  usuarios    Usuario[]
  permisos    RolPermiso[]

  @@map("rol")
}

model Permiso {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique
  nombre      String
  descripcion String?
  roles       RolPermiso[]

  @@map("permiso")
}

model RolPermiso {
  rolId     Int      @map("rol_id")
  permisoId Int      @map("permiso_id")
  rol       Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso  @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

model Usuario {
  id                 BigInt             @id @default(autoincrement())
  nombre             String
  apellido           String
  correo             String             @unique
  telefono           String?
  documento          String             @unique
  contrasenaHash     String             @map("contrasena_hash")
  activo             Boolean            @default(true)
  rolId              Int                @map("rol_id")
  municipioId        Int?               @map("municipio_id")
  organizacionId     BigInt?            @map("organizacion_id")
  fechaCreacion      DateTime           @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime           @default(now()) @updatedAt @map("fecha_actualizacion")
  rol                Rol                @relation(fields: [rolId], references: [id])
  municipio          Municipio?         @relation(fields: [municipioId], references: [id])
  organizacion       Organizacion?      @relation(fields: [organizacionId], references: [id])
  auditorias        Auditoria[]
  notificaciones    Notificacion[]
  afectaciones      Afectacion[]
  centrosAuditados  AuditoriaCentro[]
  centrosAprobados  CentroAcopio[]

  @@map("usuario")
}

model Afectacion {
  id                 BigInt    @id @default(autoincrement())
  municipioId        Int       @map("municipio_id")
  nombre             String
  descripcion        String?
  tipo               String
  severidad         String?  @default("MEDIA")
  estado            String?  @default("ACTIVA")
  latitud           Decimal? @db.Decimal(10, 8)
  longitud          Decimal? @db.Decimal(11, 8)
  ubicacion         Unsupported("geometry(Point, 4326)")?
  direccion         String?
  fechaInicio       DateTime @map("fecha_inicio") @db.Date
  fechaRegistro     DateTime @default(now()) @map("fecha_registro")
  creadoPor         BigInt   @map("creado_por")
  municipio         Municipio @relation(fields: [municipioId], references: [id])
  usuarioCreador    Usuario   @relation(fields: [creadoPor], references: [id])
  solicitudes      SolicitudAyuda[]

  @@map("afectacion")
}

model CentroAcopio {
  id                 BigInt            @id @default(autoincrement())
  municipioId        Int               @map("municipio_id")
  organizacionId     BigInt            @map("organizacion_id")
  nombre             String
  direccion          String
  barrio             String?
  responsable        String
  telefono           String
  latitud            Decimal?          @db.Decimal(10, 8)
  longitud           Decimal?          @db.Decimal(11, 8)
  ubicacion          Unsupported("geometry(Point, 4326)")?
  fotoFachada        String?           @map("foto_fachada")
  estado             String            @default("PENDIENTE")
  fechaSolicitud     DateTime          @default(now()) @map("fecha_solicitud")
  fechaAprobacion    DateTime?         @map("fecha_aprobacion")
  aprobadoPor        BigInt?           @map("aprobado_por")
  municipio          Municipio         @relation(fields: [municipioId], references: [id])
  organizacion       Organizacion      @relation(fields: [organizacionId], references: [id])
  usuarioAprobador   Usuario?          @relation(fields: [aprobadoPor], references: [id])
  auditorias        AuditoriaCentro[]
  inventarios       Inventario[]
  entradas          EntradaInventario[]
  salidas           SalidaInventario[]

  @@map("centro_acopio")
}

model AuditoriaCentro {
  id               BigInt        @id @default(autoincrement())
  centroAcopioId   BigInt        @map("centro_acopio_id")
  auditorId        BigInt        @map("auditor_id")
  decision         String
  comentario       String
  fotoEvidencia    String        @map("foto_evidencia")
  latitud          Decimal?      @db.Decimal(10, 8)
  longitud         Decimal?      @db.Decimal(11, 8)
  ubicacion        Unsupported("geometry(Point, 4326)")?
  fecha            DateTime      @default(now())
  centroAcopio     CentroAcopio  @relation(fields: [centroAcopioId], references: [id], onDelete: Cascade)
  auditor          Usuario       @relation(fields: [auditorId], references: [id])

  @@map("auditoria_centro")
}

model Inventario {
  id                  BigInt           @id @default(autoincrement())
  centroAcopioId      BigInt           @map("centro_acopio_id")
  municipioId         Int              @map("municipio_id")
  tipoAyuda           String           @map("tipo_ayuda")
  unidadMedida        String           @map("unidad_medida")
  cantidadActual      Decimal          @default(0) @map("cantidad_actual") @db.Decimal(12, 2)
  pesoActual          Decimal          @default(0) @map("peso_actual") @db.Decimal(12, 2)
  fechaActualizacion  DateTime         @default(now()) @updatedAt @map("fecha_actualizacion")
  centroAcopio        CentroAcopio     @relation(fields: [centroAcopioId], references: [id], onDelete: Cascade)
  lotes               Lote[]

  @@unique([centroAcopioId, tipoAyuda])
  @@map("inventario")
}

model Lote {
  id               BigInt           @id @default(autoincrement())
  codigoQr         String           @unique @map("codigo_qr")
  inventarioId     BigInt           @map("inventario_id")
  tipoAyuda        String           @map("tipo_ayuda")
  cantidadInicial  Decimal          @map("cantidad_inicial") @db.Decimal(12, 2)
  cantidadActual   Decimal          @map("cantidad_actual") @db.Decimal(12, 2)
  peso             Decimal          @default(0) @db.Decimal(12, 2)
  fechaIngreso     DateTime         @default(now()) @map("fecha_ingreso")
  origen           String
  estado           String           @default("DISPONIBLE")
  inventario       Inventario       @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  entradas         EntradaInventario[]
  salidas          SalidaInventario[]
  entregas         EntregaAyuda[]

  @@map("lote")
}

model EntradaInventario {
  id                   BigInt       @id @default(autoincrement())
  centroAcopioId       BigInt       @map("centro_acopio_id")
  loteId               BigInt?      @map("lote_id")
  tipoAyuda            String       @map("tipo_ayuda")
  cantidad             Decimal      @db.Decimal(12, 2)
  peso                 Decimal?     @db.Decimal(12, 2)
  origen               String
  numeroDocumento      String?      @map("numero_documento")
  fotoCamion           String?      @map("foto_camion")
  fecha                DateTime     @default(now())
  usuarioId            BigInt       @map("usuario_id")
  identificadorOffline String?      @unique @map("identificador_offline")
  centroAcopio         CentroAcopio @relation(fields: [centroAcopioId], references: [id])
  lote                 Lote?        @relation(fields: [loteId], references: [id])

  @@map("entrada_inventario")
}

model Beneficiario {
  id                 BigInt    @id @default(autoincrement())
  codigoFamilia      String    @unique @map("codigo_familia")
  municipioId        Int       @map("municipio_id")
  barrio             String?
  direccion          String?
  latitud            Decimal?  @db.Decimal(10, 8)
  longitud           Decimal?  @db.Decimal(11, 8)
  ubicacion          Unsupported("geometry(Point, 4326)")?
  cantidadPersonas   Int       @map("cantidad_personas")
  contacto           String?
  estado             String    @default("ACTIVO")
  fechaRegistro      DateTime  @default(now()) @map("fecha_registro")
  municipio          Municipio @relation(fields: [municipioId], references: [id])
  solicitudes        SolicitudAyuda[]
  entregas           EntregaAyuda[]
  salidas            SalidaInventario[]

  @@map("beneficiario")
}

model SalidaInventario {
  id                  BigInt        @id @default(autoincrement())
  centroAcopioId      BigInt        @map("centro_acopio_id")
  loteId              BigInt?       @map("lote_id")
  cantidad            Decimal       @db.Decimal(12, 2)
  peso                Decimal?      @db.Decimal(12, 2)
  beneficiarioId      BigInt?       @map("beneficiario_id")
  municipioId         Int           @map("municipio_id")
  barrio              String?
  fotoEntrega         String        @map("foto_entrega")
  fecha               DateTime      @default(now())
  usuarioId           BigInt        @map("usuario_id")
  identificadorOffline String?      @unique @map("identificador_offline")
  centroAcopio        CentroAcopio  @relation(fields: [centroAcopioId], references: [id])
  lote                Lote?         @relation(fields: [loteId], references: [id])
  beneficiario        Beneficiario? @relation(fields: [beneficiarioId], references: [id])

  @@map("salida_inventario")
}

model SolicitudAyuda {
  id                BigInt      @id @default(autoincrement())
  beneficiarioId    BigInt      @map("beneficiario_id")
  afectacionId      BigInt      @map("afectacion_id")
  tipoNecesidad     String      @map("tipo_necesidad")
  prioridad         String      @default("MEDIA")
  descripcion       String?
  cantidadSolicitada Decimal     @map("cantidad_solicitada") @db.Decimal(12, 2)
  evidencia         String?
  estado            String      @default("PENDIENTE")
  fechaSolicitud    DateTime    @default(now()) @map("fecha_solicitud")
  atendidaPor       BigInt?     @map("atendida_por")
  beneficiario      Beneficiario @relation(fields: [beneficiarioId], references: [id])
  afectacion        Afectacion  @relation(fields: [afectacionId], references: [id])
  entregas          EntregaAyuda[]

  @@map("solicitud_ayuda")
}

model EntregaAyuda {
  id                   BigInt          @id @default(autoincrement())
  solicitudId          BigInt?         @map("solicitud_id")
  beneficiarioId       BigInt          @map("beneficiario_id")
  loteId              BigInt?         @map("lote_id")
  cantidad            Decimal         @db.Decimal(12, 2)
  responsableEntrega  BigInt          @map("responsable_entrega")
  evidencia           String
  fecha               DateTime        @default(now())
  latitud             Decimal?        @db.Decimal(10, 8)
  longitud            Decimal?        @db.Decimal(11, 8)
  ubicacion           Unsupported("geometry(Point, 4326)")?
  observaciones        String?
  identificadorOffline String?        @unique @map("identificador_offline")
  solicitud           SolicitudAyuda? @relation(fields: [solicitudId], references: [id])
  beneficiario        Beneficiario    @relation(fields: [beneficiarioId], references: [id])
  lote                Lote?           @relation(fields: [loteId], references: [id])

  @@map("entrega_ayuda")
}

model Donacion {
  id             BigInt             @id @default(autoincrement())
  organizacionId BigInt?            @map("organizacion_id")
  tipo           String
  donante        String
  monto          Decimal?           @db.Decimal(15, 2)
  descripcion    String?
  municipioId    Int?               @map("municipio_id")
  fecha          DateTime           @default(now())
  estado         String             @default("PENDIENTE")
  organizacion   Organizacion?      @relation(fields: [organizacionId], references: [id])
  dinero         DonacionDinero?
  especie        DonacionEspecie?

  @@map("donacion")
}

model DonacionDinero {
  donacionId      BigInt     @id @map("donacion_id")
  cuentaDestino   String     @map("cuenta_destino")
  referencia      String
  monto           Decimal    @db.Decimal(15, 2)
  soporteArchivo  String     @map("soporte_archivo")
  donacion        Donacion   @relation(fields: [donacionId], references: [id], onDelete: Cascade)

  @@map("donacion_dinero")
}

model DonacionEspecie {
  donacionId      BigInt     @id @map("donacion_id")
  tipoAyuda       String     @map("tipo_ayuda")
  cantidad        Decimal    @db.Decimal(12, 2)
  peso            Decimal?   @db.Decimal(12, 2)
  unidadMedida    String     @map("unidad_medida")
  donacion        Donacion   @relation(fields: [donacionId], references: [id], onDelete: Cascade)

  @@map("donacion_especie")
}

model Gasto {
  id             BigInt       @id @default(autoincrement())
  organizacionId BigInt       @map("organizacion_id")
  concepto       String
  monto          Decimal      @db.Decimal(15, 2)
  proveedor      String
  numeroFactura  String       @map("numero_factura")
  fecha          DateTime     @db.Date
  soporte        String
  estado         String       @default("BORRADOR")
  creadoPor      BigInt       @map("creado_por")
  aprobadoPor    BigInt?      @map("aprobado_por")
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id])

  @@map("gasto")
}

model Albergue {
  id                 BigInt    @id @default(autoincrement())
  municipioId        Int       @map("municipio_id")
  nombre             String
  direccion          String
  latitud            Decimal?  @db.Decimal(10, 8)
  longitud           Decimal?  @db.Decimal(11, 8)
  ubicacion          Unsupported("geometry(Point, 4326)")?
  capacidad          Int
  ocupacion          Int?      @default(0)
  responsable        String
  telefono           String
  servicios          String?
  estado             String    @default("DISPONIBLE")
  fechaActualizacion DateTime  @default(now()) @updatedAt @map("fecha_actualizacion")
  municipio          Municipio @relation(fields: [municipioId], references: [id])

  @@map("albergue")
}

model Denuncia {
  id                  BigInt    @id @default(autoincrement())
  tipo                String
  descripcion         String
  municipioId         Int       @map("municipio_id")
  barrio              String?
  latitud             Decimal?  @db.Decimal(10, 8)
  longitud            Decimal?  @db.Decimal(11, 8)
  ubicacion           Unsupported("geometry(Point, 4326)")?
  evidencia           String?
  fecha               DateTime  @default(now())
  estado              String    @default("RECIBIDA")
  respuesta            String?
  atendidoPor         BigInt?   @map("atendido_por")
  identificadorOffline String?  @unique @map("identificador_offline")
  municipio           Municipio @relation(fields: [municipioId], references: [id])

  @@map("denuncia")
}

model Notificacion {
  id            BigInt    @id @default(autoincrement())
  usuarioId      BigInt?   @map("usuario_id")
  municipioId    Int?      @map("municipio_id")
  tipo           String
  titulo         String
  mensaje        String
  leido          Boolean   @default(false)
  fechaCreacion  DateTime  @default(now()) @map("fecha_creacion")
  usuario        Usuario?  @relation(fields: [usuarioId], references: [id])

  @@map("notificacion")
}

model Auditoria {
  id                 BigInt    @id @default(autoincrement())
  usuarioId          BigInt?   @map("usuario_id")
  modulo            String
  accion            String
  entidad           String
  entidadId         String?   @map("entidad_id")
  datosAnteriores   Json?     @map("datos_anteriores")
  datosNuevos       Json?     @map("datos_nuevos")
  ip                String?
  fecha             DateTime  @default(now())
  usuario           Usuario?  @relation(fields: [usuarioId], references: [id])

  @@map("auditoria")
}

model Configuracion {
  clave       String @id
  valor       String
  descripcion String?

  @@map("configuracion")
}
