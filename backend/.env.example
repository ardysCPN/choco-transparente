# ==============================================================================
# VARIABLES DE ENTORNO BACKEND — CHOCÓ TRANSPARENTE
# ==============================================================================

# Entorno de ejecución: development | test | production
NODE_ENV=production

# Puerto HTTP del API Backend
PORT=4000

# Conexión a PostgreSQL (con extensión PostGIS habilitada)
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/choco_transparente?schema=public"

# Claves secretas para firma de tokens JWT (Generar cadenas aleatorias de 64 caracteres)
JWT_SECRET="genera_una_clave_secreta_jwt_fuerte_aqui_minimo_32_caracteres"
JWT_REFRESH_SECRET="genera_otra_clave_secreta_refresh_fuerte_aqui_minimo_32_caracteres"

# Duración de tokens
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# Orígenes permitidos por CORS (separados por coma si son varios)
CORS_ORIGIN="http://localhost:5173,https://chocotransparente.gov.co,https://tu-dominio-dokploy.com"
