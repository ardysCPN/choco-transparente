      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    var token = jsonData.token || (jsonData.datos && jsonData.datos.token);",
                  "    if (token) {",
                  "        pm.collectionVariables.set('jwt_token', token);",
                  "        console.log('Token JWT capturado y actualizado automáticamente.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@chocotransparente.gov.co\",\n  \"contrasena\": \"AdminChoco2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/autenticacion/iniciar-sesion",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "autenticacion", "iniciar-sesion"]
            },
            "description": "Autenticación de usuario. Guarda automáticamente el Bearer token en la variable {{jwt_token}}."
